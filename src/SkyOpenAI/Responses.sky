module SkyOpenAI.Responses exposing
    ( ReasoningEffort(..)
    , SkillVersion(..)
    , HostedSkill
    , UploadedSkill
    , RequestOptions
    , provider
    , providerWithReasoningEffort
    , providerAt
    , providerAtWithReasoningEffort
    , providerWithOptions
    , providerAtWithOptions
    , encodeRequest
    , decodeResponse
    , encodeRequestWithOptions
    , uploadSkillZip
    , encodeSkillUploadBody
    , decodeUploadedSkill
    )

{-| `SkyOpenAI.Responses` — the OpenAI Responses API as a Sky `Provider`.

The Responses API (`POST /v1/responses`) is OpenAI's newer interaction model. This
module maps a Sky chat (a `List Provider.Message`) onto a single Responses call and
returns the assistant text plus token usage, so it drops into `Std.Ai.Agent`,
`Policy`, `Trace`, and `cost` exactly like the built-in chat-completions provider.

It is built on `Provider.custom`, the `Std.Ai.Provider` extension point, so no
compiler or stdlib change is needed to add it.

    import SkyOpenAI.Responses as Responses
    import Sky.Core.Secret as Secret

    provider =
        Responses.provider (Secret.fromEnv "OPENAI_API_KEY") "gpt-4o-mini"

Hosted Skills are uploaded as ZIP files and mounted into OpenAI's hosted shell:

    skill =
        { skillId = "skill_..."
        , version = Just (Responses.Number 2)
        }

    provider =
        Responses.providerWithOptions
            (Secret.fromEnv "OPENAI_API_KEY")
            "gpt-6-astra"
            { reasoningEffort = Nothing
            , hostedSkills = [ skill ]
            }

This module sends messages as the Responses `input`, optionally sets
`reasoning.effort`, attaches hosted Skills through `container_auto`, reads the
`output_text` parts from message items, and returns token usage. Stateful chaining
(`previous_response_id`), the server-side built-in tools (web_search, file_search),
and native function-calling remain outside this first provider surface.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Task as Task
import Sky.Core.Error as Error
import Sky.Core.String as String
import Sky.Core.Bytes as Bytes
import Sky.Core.File as File
import Sky.Core.Secret exposing (Secret)
import Sky.Core.Http as Http
import Sky.Core.Json.Encode as JsonE
import Sky.Core.Json.Decode as JsonD
import Std.Ai.Provider as Provider exposing (ChatResponse, Message, Provider)

{-| The documented `reasoning.effort` values for a Responses request.

Support remains model-dependent; callers must choose a level accepted by the
selected model. OpenAI returns HTTP 400 for an unsupported level.
-}
type ReasoningEffort
    = None
    | Minimal
    | Low
    | Medium
    | High
    | XHigh
    | Max

{-| A hosted Skill version selector.

`Latest` floats to the API's latest uploaded version. `Number` pins a specific
version. A missing version uses the Skill's default version.
-}
type SkillVersion
    = Latest
    | Number Int

{-| A hosted Skill to attach to a Responses shell tool. -}
type alias HostedSkill =
    { skillId : String
    , version : Maybe SkillVersion
    }

{-| The Skill metadata returned after a ZIP upload. -}
type alias UploadedSkill =
    { id : String
    , name : String
    , description : String
    , defaultVersion : Int
    , latestVersion : Int
    }

{-| Optional Responses provider behavior. Empty `hostedSkills` preserves the
legacy request shape and does not add a shell tool.
-}
type alias RequestOptions =
    { reasoningEffort : Maybe ReasoningEffort
    , hostedSkills : List HostedSkill
    }


{-| A Responses provider against the hosted OpenAI endpoint.

This leaves `reasoning.effort` unset and attaches no hosted Skills, so OpenAI
selects the model default and the legacy request shape is preserved.
-}
provider : Secret -> String -> Provider
provider apiKey model =
    providerAtWithOptions
        "https://api.openai.com/v1/responses"
        apiKey
        model
        { reasoningEffort = Nothing, hostedSkills = [] }


{-| A hosted Responses provider that sets `reasoning.effort`.

    Responses.providerWithReasoningEffort apiKey "gpt-5.6-luna" High
-}
providerWithReasoningEffort : Secret -> String -> ReasoningEffort -> Provider
providerWithReasoningEffort apiKey model effort =
    providerAtWithOptions
        "https://api.openai.com/v1/responses"
        apiKey
        model
        { reasoningEffort = Just effort, hostedSkills = [] }


{-| A Responses provider against a specific endpoint — an Azure deployment, a
proxy, or a compatible gateway. This leaves `reasoning.effort` unset and attaches
no hosted Skills.
-}
providerAt : String -> Secret -> String -> Provider
providerAt endpoint apiKey model =
    providerAtWithOptions
        endpoint
        apiKey
        model
        { reasoningEffort = Nothing, hostedSkills = [] }


{-| A Responses provider against a specific endpoint that sets
`reasoning.effort`.
-}
providerAtWithReasoningEffort : String -> Secret -> String -> ReasoningEffort -> Provider
providerAtWithReasoningEffort endpoint apiKey model effort =
    providerAtWithOptions
        endpoint
        apiKey
        model
        { reasoningEffort = Just effort, hostedSkills = [] }


{-| A hosted Responses provider with request options, including hosted Skills. -}
providerWithOptions : Secret -> String -> RequestOptions -> Provider
providerWithOptions apiKey model options =
    providerAtWithOptions
        "https://api.openai.com/v1/responses"
        apiKey
        model
        options


{-| A Responses provider against a specific endpoint with request options. -}
providerAtWithOptions : String -> Secret -> String -> RequestOptions -> Provider
providerAtWithOptions endpoint apiKey model options =
    Provider.custom (chatViaResponses endpoint apiKey model options)


chatViaResponses : String -> Secret -> String -> RequestOptions -> List Message -> Task Error ChatResponse
chatViaResponses endpoint apiKey model options messages =
    let
        req = Http.defaultRequest endpoint
    in
        { req | method = "POST" } |> Http.withBearer apiKey
            |> Http.withHeader "Content-Type" "application/json"
            |> Http.withBody (encodeRequestWithOptions model options messages)
            |> Http.request
            |> Task.andThen
                   (\resp ->
                       if resp.status >= 200 && resp.status < 300 then
                           case JsonD.decodeString responseDecoder resp.body of

                               Ok r ->
                                   Task.succeed r

                               Err e ->
                                   Task.fail e

                       else
                           Task.fail
                               (Error.unexpected
                                   ("OpenAI Responses failed: HTTP "
                                       ++ String.fromInt resp.status
                                       ++ " — "
                                       ++ resp.body)))


{-| Upload a local Skill ZIP to OpenAI's
 hosted Skills API.

The ZIP is sent as the single `files` multipart field. `Http.withBody` transports
raw bytes, and the body is assembled with `Sky.Core.Bytes`, so ZIP bytes are not
interpreted as UTF-8 text. The local path is used only for reading and is never
sent as a request filename.
-}
uploadSkillZip : Secret -> String -> Task Error UploadedSkill
uploadSkillZip apiKey zipPath =
    File.readFileBytes zipPath |> Task.andThen (uploadSkillBytes apiKey)


uploadSkillBytes apiKey bytes =
    Http.defaultRequest "https://api.openai.com/v1/skills"
        |> Http.withMethod "POST"
        |> Http.withBearer apiKey
        |> Http.withHeader
               "Content-Type"
               ("multipart/form-data; boundary=" ++ skillUploadBoundary)
        |> Http.withBody (encodeSkillUploadBody bytes)
        |> Http.request
        |> Task.andThen uploadResponse


{-| Decode a raw OpenAI Responses API body into a `Provider.ChatResponse` — the
assistant text (the `output_text` parts joined) and the token `usage`. Exposed
so a caller can decode a body it fetched itself, and so the mapping is testable.
-}
decodeResponse : String -> Result Error ChatResponse
decodeResponse body =
    JsonD.decodeString responseDecoder body


{-| Decode the JSON object returned by `uploadSkillZip`. Exposed for offline
response-decoder tests and callers that fetch the upload response themselves.
-}
decodeUploadedSkill : String -> Result Error UploadedSkill
decodeUploadedSkill body =
    JsonD.decodeString uploadedSkillDecoder body


uploadResponse : Http.HttpResponse -> Task Error UploadedSkill
uploadResponse resp =
    if resp.status >= 200 && resp.status < 300 then
        case decodeUploadedSkill resp.body of

            Ok skill ->
                Task.succeed skill

            Err e ->
                Task.fail e

    else
        Task.fail
            (Error.unexpected
                ("OpenAI Skills upload failed: HTTP "
                    ++ String.fromInt resp.status))


skillUploadBoundary : String
skillUploadBoundary =
    "SkyOpenAISkillUploadBoundary"


{-| Build the raw multipart body for a ZIP Skill upload.

The input is a `List Int` because that is the result of
`File.readFileBytes`. `String.fromBytes` and `Sky.Core.Bytes` preserve each
input value as one wire byte; `Bytes.append` then concatenates without any
text encoding or rune-based slicing.
-}
encodeSkillUploadBody : List Int -> String
encodeSkillUploadBody zipBytes =
    let
        zip = Bytes.fromString (String.fromBytes zipBytes)
        prefix =
            Bytes.fromString
                ("--" ++ skillUploadBoundary
                    ++ "\r\nContent-Disposition: form-data; name=\"files\"; filename=\"skill.zip\"\r\nContent-Type: application/zip\r\n\r\n")
        suffix =
            Bytes.fromString ("\r\n--" ++ skillUploadBoundary ++ "--\r\n")
    in
        Bytes.append prefix (Bytes.append zip suffix)


{-| Encode the Responses API request body with legacy options. Passing `Nothing`
to the old function omits `reasoning`, preserving the model default.
-}
encodeRequest : String -> Maybe ReasoningEffort -> List Message -> String
encodeRequest model effort messages =
    encodeRequestWithOptions
        model
        { reasoningEffort = effort, hostedSkills = [] }
        messages


{-| Encode a Responses API request body, including a hosted shell tool when
`hostedSkills` is non-empty. Versions are sent as strings because that is the
Skills API wire format (`"latest"` or a numeric version such as `"2"`).
-}
encodeRequestWithOptions : String -> RequestOptions -> List Message -> String
encodeRequestWithOptions model options messages =
    JsonE.encode 0 (JsonE.object (requestFields model options messages))


requestFields : String -> RequestOptions -> List Message -> List ( String, JsonE.Value )
requestFields model options messages =
    let
        base =
            [ ( "model", JsonE.string model )
            , ( "input", JsonE.list messageValue messages )
            ]
        withReasoning =
            case options.reasoningEffort of

                Just selectedEffort ->
                    base
                        ++ [ ( "reasoning"
                             , JsonE.object
                                   [ ( "effort"
                                     , JsonE.string
                                           (reasoningEffortValue selectedEffort)
                                     )
                                   ]
                             )
                           ]

                Nothing ->
                    base
    in
        case options.hostedSkills of

            [] ->
                withReasoning

            skills ->
                withReasoning
                    ++ [ ( "tools", JsonE.list hostedShellTool [ skills ] ) ]


hostedShellTool : List HostedSkill -> JsonE.Value
hostedShellTool skills =
    JsonE.object
        [ ( "type", JsonE.string "shell" )
        , ( "environment"
          , JsonE.object
                [ ( "type", JsonE.string "container_auto" )
                , ( "skills", JsonE.list skillReference skills )
                ]
          )
        ]


skillReference : HostedSkill -> JsonE.Value
skillReference skill =
    case skill.version of

        Nothing ->
            JsonE.object
                [ ( "type", JsonE.string "skill_reference" )
                , ( "skill_id", JsonE.string skill.skillId )
                ]

        Just selectedVersion ->
            JsonE.object
                [ ( "type", JsonE.string "skill_reference" )
                , ( "skill_id", JsonE.string skill.skillId )
                , ( "version"
                  , JsonE.string (skillVersionValue selectedVersion)
                  )
                ]


skillVersionValue : SkillVersion -> String
skillVersionValue version =
    case version of

        Latest ->
            "latest"

        Number n ->
            String.fromInt n


reasoningEffortValue : ReasoningEffort -> String
reasoningEffortValue effort =
    case effort of

        None ->
            "none"

        Minimal ->
            "minimal"

        Low ->
            "low"

        Medium ->
            "medium"

        High ->
            "high"

        XHigh ->
            "xhigh"

        Max ->
            "max"


messageValue m =
    JsonE.object
        [ ( "role", JsonE.string m.role )
        , ( "content", JsonE.string m.content )
        ]


responseDecoder =
    JsonD.map2
        (\content usage -> { content = content, usage = usage })
        outputText
        (JsonD.oneOf
            [ JsonD.field "usage" usageDecoder
            , JsonD.succeed
                  { promptTokens = 0, completionTokens = 0, totalTokens = 0 }
            ])


-- The Responses API returns an `output` array of items; only a message item
-- carries assistant text. A shell call/output, reasoning item, or other
-- non-message item contributes nothing rather than failing the whole response.
outputText =
    JsonD.oneOf
        [ JsonD.field "output" (JsonD.list itemText)
              |> JsonD.map (String.join "")
        , JsonD.succeed ""
        ]


itemText =
    JsonD.map2
        (\ty content ->
            if ty == "message" then
                content

            else
                "")
        (JsonD.oneOf [ JsonD.field "type" JsonD.string, JsonD.succeed "" ])
        (JsonD.oneOf
            [ JsonD.field "content" (JsonD.list partText)
                  |> JsonD.map (String.join "")
            , JsonD.succeed ""
            ])


partText =
    JsonD.map2
        (\ty txt ->
            if ty == "output_text" then
                txt

            else
                "")
        (JsonD.oneOf [ JsonD.field "type" JsonD.string, JsonD.succeed "" ])
        (JsonD.oneOf [ JsonD.field "text" JsonD.string, JsonD.succeed "" ])


usageDecoder =
    JsonD.map3
        (\i o t -> { promptTokens = i, completionTokens = o, totalTokens = t })
        (JsonD.oneOf [ JsonD.field "input_tokens" JsonD.int, JsonD.succeed 0 ])
        (JsonD.oneOf [ JsonD.field "output_tokens" JsonD.int, JsonD.succeed 0 ])
        (JsonD.oneOf [ JsonD.field "total_tokens" JsonD.int, JsonD.succeed 0 ])


uploadedSkillDecoder =
    JsonD.map5
        (\id name description defaultVersion latestVersion ->
            { id = id
            , name = name
            , description = description
            , defaultVersion = defaultVersion
            , latestVersion = latestVersion
            })
        (JsonD.field "id" JsonD.string)
        (JsonD.field "name" JsonD.string)
        (JsonD.field "description" JsonD.string)
        (JsonD.field "default_version" JsonD.int)
        (JsonD.field "latest_version" JsonD.int)
