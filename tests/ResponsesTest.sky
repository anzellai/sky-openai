module ResponsesTest exposing (tests)

{-| Offline tests for `SkyOpenAI.Responses`. They decode a canonical OpenAI
Responses API body into a `Provider.ChatResponse` and encode request payloads.
No network.
-}

import Sky.Core.Json.Decode as JsonD
import Sky.Core.Prelude exposing (..)
import Sky.Core.Result exposing (Result(..))
import Sky.Test as Test exposing (Test)
import SkyOpenAI.Responses as Responses
import Std.Ai.Provider as Provider


sampleBody : String
sampleBody =
    "{\"id\":\"resp_1\",\"model\":\"gpt-4o-mini\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello there\",\"annotations\":[]}]}],\"usage\":{\"input_tokens\":12,\"output_tokens\":3,\"total_tokens\":15}}"


toolCallBody : String
toolCallBody =
    "{\"id\":\"resp_tool_1\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"function_call\",\"id\":\"fc_1\",\"call_id\":\"call_weather\",\"name\":\"weather\",\"arguments\":\"{\\\"city\\\":\\\"Berlin\\\"}\",\"status\":\"completed\"}],\"usage\":{\"input_tokens\":12,\"output_tokens\":3,\"total_tokens\":15}}"


mixedOutputBody : String
mixedOutputBody =
    """
    {
      "id": "resp_mixed",
      "output": [
        {"type": "message", "role": "assistant", "content": [
          {"type": "output_text", "text": "Hello ", "annotations": []},
          {"type": "refusal", "refusal": "Ignored refusal."},
          {"type": "output_text", "text": "there", "annotations": []}
        ]},
        {"type": "function_call", "call_id": "call_weather", "name": "weather", "arguments": "{}"},
        {"type": "reasoning", "summary": [{"type": "summary_text", "text": "Ignored reasoning."}]},
        {"type": "message", "role": "assistant", "content": [
          {"type": "output_text", "text": "! ", "annotations": []},
          {"type": "output_text", "text": "Goodbye.", "annotations": []}
        ]}
      ],
      "usage": {"input_tokens": 21, "output_tokens": 8, "total_tokens": 29}
    }
    """


toolOptions : Responses.RequestOptions
toolOptions =
    { reasoningEffort = Nothing }


weatherTool : Provider.ToolSpec
weatherTool =
    { name = "weather", description = "Return current weather." }


responsesToolCall : Provider.ToolCall
responsesToolCall =
    { id = "call_weather"
    , name = "weather"
    , arguments = "{\"city\":\"Berlin\"}"
    , continuation = Just "sky-openai-responses:resp_tool_1"
    }


foreignToolCall : Provider.ToolCall
foreignToolCall =
    { id = "call_weather"
    , name = "weather"
    , arguments = "{\"city\":\"Berlin\"}"
    , continuation = Just "other-provider:response_1"
    }


forecastToolCall : Provider.ToolCall
forecastToolCall =
    { id = "call_forecast"
    , name = "forecast"
    , arguments = "{}"
    , continuation = Just "sky-openai-responses:resp_tool_1"
    }


expectJson : String -> String -> Test.TestResult
expectJson expected actual =
    case JsonD.decodeString JsonD.value expected of

        Ok expectedValue ->
            Test.equal
                (Ok expectedValue)
                (JsonD.decodeString JsonD.value actual)

        Err _ ->
            Test.fail "invalid expected JSON"


tests : List Test
tests =
    [ Test.suite
          "SkyOpenAI.Responses"
          [ Test.test
                "decodes Responses output text"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok response ->
                            Test.equal "Hello there" response.content

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "reads Responses usage"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok response ->
                            Test.equal
                                ( 12, 3, 15 )
                                ( response.usage.promptTokens
                                , response.usage.completionTokens
                                , response.usage.totalTokens
                                )

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "omits reasoning when it is not configured"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}]}"
                        (Responses.encodeRequest
                            "gpt-5.6-luna"
                            Nothing
                            [ Provider.user "Solve it." ]))
          , Test.test
                "encodes every GPT-5.6 Luna reasoning effort"
                (\_ ->
                    Test.equal
                        [ "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"none\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"low\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"medium\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"high\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"xhigh\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"max\"}}"
                        ]
                        (List.map
                            (\effort ->
                                Responses.encodeRequest
                                    "gpt-5.6-luna"
                                    (Just effort)
                                    [ Provider.user "Solve it." ])
                            [ Responses.None
                            , Responses.Low
                            , Responses.Medium
                            , Responses.High
                            , Responses.XHigh
                            , Responses.Max
                            ]))
          , Test.test
                "encodes the model-dependent minimal effort"
                (\_ ->
                    Test.equal
                        "{\"model\":\"reasoning-model\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"minimal\"}}"
                        (Responses.encodeRequest
                            "reasoning-model"
                            (Just Responses.Minimal)
                            [ Provider.user "Solve it." ]))
          , Test.test
                "decodes Responses function calls with a continuation"
                (\_ ->
                    case Responses.decodeToolResponse toolCallBody of

                        Ok response ->
                            Test.equal
                                ( "", [ responsesToolCall ], ( 12, 3, 15 ) )
                                ( response.content
                                , response.toolCalls
                                , ( response.usage.promptTokens
                                  , response.usage.completionTokens
                                  , response.usage.totalTokens
                                  )
                                )

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "encodes local functions as flat Responses tools"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Weather in Berlin?\"}],\"tools\":[{\"type\":\"function\",\"name\":\"weather\",\"description\":\"Return current weather.\",\"parameters\":{\"type\":\"object\"},\"strict\":false}]}"
                        (Responses.encodeToolRequest
                            "gpt-5.6-luna"
                            toolOptions
                            [ Provider.Say (Provider.user "Weather in Berlin?")
                            ]
                            [ weatherTool ]))
          , Test.test
                "continues Responses tool results with previous_response_id"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"type\":\"function_call_output\",\"call_id\":\"call_weather\",\"output\":\"18 C\"}],\"previous_response_id\":\"resp_tool_1\",\"tools\":[{\"type\":\"function\",\"name\":\"weather\",\"description\":\"Return current weather.\",\"parameters\":{\"type\":\"object\"},\"strict\":false}]}"
                        (Responses.encodeToolRequest
                            "gpt-5.6-luna"
                            toolOptions
                            [ Provider.Say (Provider.user "Weather in Berlin?")
                            , Provider.Called [ responsesToolCall ]
                            , Provider.Returned responsesToolCall "18 C"
                            ]
                            [ weatherTool ]))
          , Test.test
                "replays tool turns for a foreign continuation"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Weather in Berlin?\"},{\"type\":\"function_call\",\"call_id\":\"call_weather\",\"name\":\"weather\",\"arguments\":\"{\\\"city\\\":\\\"Berlin\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_weather\",\"output\":\"18 C\"}],\"tools\":[{\"type\":\"function\",\"name\":\"weather\",\"description\":\"Return current weather.\",\"parameters\":{\"type\":\"object\"},\"strict\":false}]}"
                        (Responses.encodeToolRequest
                            "gpt-5.6-luna"
                            toolOptions
                            [ Provider.Say (Provider.user "Weather in Berlin?")
                            , Provider.Called [ foreignToolCall ]
                            , Provider.Returned foreignToolCall "18 C"
                            ]
                            [ weatherTool ]))
          , Test.test
                "latest response wins and only subsequent turns remain in order"
                (\_ ->
                    let
                        latestCall =
                            { responsesToolCall
                                | id = "call_latest"
                                , continuation =
                                    Just "sky-openai-responses:resp_latest"
                            }
                    in
                        expectJson
                            """
                            {
                              "model": "gpt-5.6-luna",
                              "previous_response_id": "resp_latest",
                              "input": [
                                {"type": "function_call_output", "call_id": "call_latest", "output": "20 C"},
                                {"role": "user", "content": "Thanks."}
                              ]
                            }
                            """
                            (Responses.encodeToolRequest
                                "gpt-5.6-luna"
                                toolOptions
                                [ Provider.Say
                                      (Provider.user "Weather in Berlin?")
                                , Provider.Called [ responsesToolCall ]
                                , Provider.Returned responsesToolCall "18 C"
                                , Provider.Say (Provider.user "Check again.")
                                , Provider.Called [ latestCall ]
                                , Provider.Returned latestCall "20 C"
                                , Provider.Say (Provider.user "Thanks.")
                                ]
                                []))
          , Test.test
                "continues multiple calls sharing one response ID"
                (\_ ->
                    expectJson
                        """
                        {
                          "model": "gpt-5.6-luna",
                          "previous_response_id": "resp_tool_1",
                          "input": [
                            {"type": "function_call_output", "call_id": "call_forecast", "output": "Sunny tomorrow"},
                            {"type": "function_call_output", "call_id": "call_weather", "output": "18 C"},
                            {"role": "user", "content": "Thanks."}
                          ]
                        }
                        """
                        (Responses.encodeToolRequest
                            "gpt-5.6-luna"
                            toolOptions
                            [ Provider.Say
                                  (Provider.user "Weather and forecast?")
                            , Provider.Called
                                  [ responsesToolCall, forecastToolCall ]
                            , Provider.Returned
                                  forecastToolCall
                                  "Sunny tomorrow"
                            , Provider.Returned responsesToolCall "18 C"
                            , Provider.Say (Provider.user "Thanks.")
                            ]
                            []))
          , Test.test
                "replays calls with mixed response IDs"
                (\_ ->
                    let
                        otherResponseCall =
                            { forecastToolCall
                                | continuation =
                                    Just "sky-openai-responses:resp_tool_2"
                            }
                    in
                        expectJson
                            """
                            {
                              "model": "gpt-5.6-luna",
                              "input": [
                                {"role": "user", "content": "Weather and forecast?"},
                                {"type": "function_call", "call_id": "call_weather", "name": "weather", "arguments": "{\"city\":\"Berlin\"}"},
                                {"type": "function_call", "call_id": "call_forecast", "name": "forecast", "arguments": "{}"},
                                {"type": "function_call_output", "call_id": "call_weather", "output": "18 C"},
                                {"type": "function_call_output", "call_id": "call_forecast", "output": "Sunny tomorrow"}
                              ]
                            }
                            """
                            (Responses.encodeToolRequest
                                "gpt-5.6-luna"
                                toolOptions
                                [ Provider.Say
                                      (Provider.user "Weather and forecast?")
                                , Provider.Called
                                      [ responsesToolCall, otherResponseCall ]
                                , Provider.Returned responsesToolCall "18 C"
                                , Provider.Returned
                                      otherResponseCall
                                      "Sunny tomorrow"
                                ]
                                []))
          , Test.suite
                "invalid latest batch never reuses an older response"
                (List.map
                    (\( label, continuation ) ->
                        Test.test
                            ("replays when the second continuation is " ++ label)
                            (\_ ->
                                let
                                    latestCall =
                                        { responsesToolCall
                                            | id = "call_latest"
                                            , continuation =
                                                Just
                                                    "sky-openai-responses:resp_latest"
                                        }
                                    invalidCall =
                                        { forecastToolCall
                                            | continuation = continuation
                                        }
                                in
                                    expectJson
                                        """
                                        {
                                          "model": "gpt-5.6-luna",
                                          "input": [
                                            {"role": "user", "content": "Weather in Berlin?"},
                                            {"type": "function_call", "call_id": "call_weather", "name": "weather", "arguments": "{\"city\":\"Berlin\"}"},
                                            {"type": "function_call_output", "call_id": "call_weather", "output": "18 C"},
                                            {"role": "user", "content": "Check again with a forecast."},
                                            {"type": "function_call", "call_id": "call_latest", "name": "weather", "arguments": "{\"city\":\"Berlin\"}"},
                                            {"type": "function_call", "call_id": "call_forecast", "name": "forecast", "arguments": "{}"},
                                            {"type": "function_call_output", "call_id": "call_latest", "output": "20 C"},
                                            {"type": "function_call_output", "call_id": "call_forecast", "output": "Sunny tomorrow"},
                                            {"role": "user", "content": "Thanks."}
                                          ]
                                        }
                                        """
                                        (Responses.encodeToolRequest
                                            "gpt-5.6-luna"
                                            toolOptions
                                            [ Provider.Say
                                                  (Provider.user
                                                      "Weather in Berlin?")
                                            , Provider.Called
                                                  [ responsesToolCall ]
                                            , Provider.Returned
                                                  responsesToolCall
                                                  "18 C"
                                            , Provider.Say
                                                  (Provider.user
                                                      "Check again with a forecast.")
                                            , Provider.Called
                                                  [ latestCall, invalidCall ]
                                            , Provider.Returned
                                                  latestCall
                                                  "20 C"
                                            , Provider.Returned
                                                  invalidCall
                                                  "Sunny tomorrow"
                                            , Provider.Say
                                                  (Provider.user "Thanks.")
                                            ]
                                            [])))
                    [ ( "missing", Nothing )
                    , ( "empty", Just "" )
                    , ( "an empty Responses ID", Just "sky-openai-responses:" )
                    , ( "foreign", Just "other-provider:response_1" )
                    ])
          , Test.test
                "replays after an empty latest Called batch"
                (\_ ->
                    expectJson
                        """
                        {
                          "model": "gpt-5.6-luna",
                          "input": [
                            {"role": "user", "content": "Weather in Berlin?"},
                            {"type": "function_call", "call_id": "call_weather", "name": "weather", "arguments": "{\"city\":\"Berlin\"}"},
                            {"type": "function_call_output", "call_id": "call_weather", "output": "18 C"},
                            {"role": "user", "content": "Thanks."}
                          ]
                        }
                        """
                        (Responses.encodeToolRequest
                            "gpt-5.6-luna"
                            toolOptions
                            [ Provider.Say (Provider.user "Weather in Berlin?")
                            , Provider.Called [ responsesToolCall ]
                            , Provider.Returned responsesToolCall "18 C"
                            , Provider.Called []
                            , Provider.Say (Provider.user "Thanks.")
                            ]
                            []))
          , Test.test
                "decodes sample text and usage without tool calls"
                (\_ ->
                    Test.equal
                        (Ok
                            { content = "Hello there"
                            , toolCalls = []
                            , usage =
                                { promptTokens = 12
                                , completionTokens = 3
                                , totalTokens = 15
                                }
                            })
                        (Responses.decodeToolResponse sampleBody))
          , Test.test
                "both decoders preserve mixed output text order and usage"
                (\_ ->
                    Test.equal
                        ( Ok
                              { content = "Hello there! Goodbye."
                              , usage =
                                  { promptTokens = 21
                                  , completionTokens = 8
                                  , totalTokens = 29
                                  }
                              }
                        , Ok
                              { content = "Hello there! Goodbye."
                              , toolCalls =
                                  [ { id = "call_weather"
                                    , name = "weather"
                                    , arguments = "{}"
                                    , continuation =
                                        Just "sky-openai-responses:resp_mixed"
                                    }
                                  ]
                              , usage =
                                  { promptTokens = 21
                                  , completionTokens = 8
                                  , totalTokens = 29
                                  }
                              }
                        )
                        ( Responses.decodeResponse mixedOutputBody
                        , Responses.decodeToolResponse mixedOutputBody
                        ))
          ]
    ]
