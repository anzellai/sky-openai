module ResponsesTest exposing (tests)

{-| Offline tests for `SkyOpenAI.Responses`. They decode a canonical OpenAI
Responses API body into a `Provider.ChatResponse` and encode request payloads.
No network.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Result exposing (Result(..))
import Sky.Test as Test exposing (Test)
import SkyOpenAI.Responses as Responses
import Std.Ai.Provider as Provider


sampleBody : String
sampleBody =
    "{\"id\":\"resp_1\",\"model\":\"gpt-4o-mini\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello there\",\"annotations\":[]}]}],\"usage\":{\"input_tokens\":12,\"output_tokens\":3,\"total_tokens\":15}}"


tests : List Test
tests =
    [ Test.suite
          "SkyOpenAI.Responses.decodeResponse"
          [ Test.test
                "joins output_text parts and skips a reasoning item"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok r ->
                            Test.equal "Hello there" r.content

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "reads Responses usage (input/output/total tokens)"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok r ->
                            Test.equal
                                ( 12, 3, 15 )
                                ( r.usage.promptTokens
                                , r.usage.completionTokens
                                , r.usage.totalTokens
                                )

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "omits reasoning when it is not configured"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}]}"
                        (Responses.encodeRequest
                            "gpt-5.6-luna"
                            Nothing
                            [ Provider.user "Solve it." ]))
          , Test.test
                "encodes every GPT-5.6 Luna reasoning effort"
                (\_ ->
                    Test.equal
                        [ "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"none\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"low\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"medium\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"high\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"xhigh\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"max\"}}"
                        ]
                        (List.map
                            (\effort ->
                                Responses.encodeRequest
                                    "gpt-5.6-luna"
                                    (Just effort)
                                    [ Provider.user "Solve it." ])
                            [ Responses.None
                            , Responses.Low
                            , Responses.Medium
                            , Responses.High
                            , Responses.XHigh
                            , Responses.Max
                            ]))
          , Test.test
                "encodes the model-dependent minimal effort"
                (\_ ->
                    Test.equal
                        "{\"model\":\"reasoning-model\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"minimal\"}}"
                        (Responses.encodeRequest
                            "reasoning-model"
                            (Just Responses.Minimal)
                            [ Provider.user "Solve it." ]))
          ]
    ]
