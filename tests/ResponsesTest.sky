module ResponsesTest exposing (tests)

{-| Offline tests for `SkyOpenAI.Responses`. They decode a canonical OpenAI
Responses API body into a `Provider.ChatResponse` and encode request payloads.
No network.
-}

import Sky.Core.Prelude exposing (..)
import Sky.Core.Bytes as Bytes
import Sky.Core.Result exposing (Result(..))
import Sky.Core.String as String
import Sky.Test as Test exposing (Test)
import SkyOpenAI.Responses as Responses
import Std.Ai.Provider as Provider


sampleBody : String
sampleBody =
    "{\"id\":\"resp_1\",\"model\":\"gpt-4o-mini\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello there\",\"annotations\":[]}]}],\"usage\":{\"input_tokens\":12,\"output_tokens\":3,\"total_tokens\":15}}"


hostedShellBody : String
hostedShellBody =
    "{\"id\":\"resp_2\",\"output\":[{\"type\":\"reasoning\",\"summary\":[]},{\"type\":\"shell_call_output\",\"call_id\":\"call_1\",\"output\":\"generated output\"},{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"The skill ran.\"}]}]}"


uploadedSkillBody : String
uploadedSkillBody =
    "{\"id\":\"skill_123\",\"name\":\"csv-insights\",\"description\":\"Analyze CSV files.\",\"default_version\":1,\"latest_version\":2}"


hostedOptions : Responses.RequestOptions
hostedOptions =
    { reasoningEffort = Nothing
    , hostedSkills =
        [ { skillId = "skill_default", version = Nothing }
        , { skillId = "skill_latest", version = Just Responses.Latest }
        , { skillId = "skill_pinned", version = Just (Responses.Number 2) }
        ]
    }


tests : List Test
tests =
    [ Test.suite
          "SkyOpenAI.Responses"
          [ Test.test
                "decodes Responses output text"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok response ->
                            Test.equal "Hello there" response.content

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "reads Responses usage"
                (\_ ->
                    case Responses.decodeResponse sampleBody of

                        Ok response ->
                            Test.equal
                                ( 12, 3, 15 )
                                ( response.usage.promptTokens
                                , response.usage.completionTokens
                                , response.usage.totalTokens
                                )

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "preserves arbitrary ZIP bytes in multipart upload body"
                (\_ ->
                    Test.equal
                        True
                        (String.contains
                            "00ff01c8"
                            (Bytes.toHex
                                (Responses.encodeSkillUploadBody
                                    [ 0, 255, 1, 200 ]))))
          , Test.test
                "decodes uploaded Skill metadata"
                (\_ ->
                    case Responses.decodeUploadedSkill uploadedSkillBody of

                        Ok skill ->
                            Test.equal
                                ( "skill_123", "csv-insights", 1, 2 )
                                ( skill.id
                                , skill.name
                                , skill.defaultVersion
                                , skill.latestVersion
                                )

                        Err _ ->
                            Test.fail "decode failed")
          , Test.test
                "omits reasoning when it is not configured"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}]}"
                        (Responses.encodeRequest
                            "gpt-5.6-luna"
                            Nothing
                            [ Provider.user "Solve it." ]))
          , Test.test
                "encodes hosted Skills as a hosted shell tool"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-6-astra\",\"input\":[{\"role\":\"user\",\"content\":\"Use the skill.\"}],\"tools\":[{\"type\":\"shell\",\"environment\":{\"type\":\"container_auto\",\"skills\":[{\"type\":\"skill_reference\",\"skill_id\":\"skill_default\"},{\"type\":\"skill_reference\",\"skill_id\":\"skill_latest\",\"version\":\"latest\"},{\"type\":\"skill_reference\",\"skill_id\":\"skill_pinned\",\"version\":\"2\"}]}}]}"
                        (Responses.encodeRequestWithOptions
                            "gpt-6-astra"
                            hostedOptions
                            [ Provider.user "Use the skill." ]))
          , Test.test
                "does not add tools for empty hosted Skills"
                (\_ ->
                    Test.equal
                        "{\"model\":\"gpt-6-astra\",\"input\":[{\"role\":\"user\",\"content\":\"Use the skill.\"}]}"
                        (Responses.encodeRequestWithOptions
                            "gpt-6-astra"
                            { reasoningEffort = Nothing, hostedSkills = [] }
                            [ Provider.user "Use the skill." ]))
          , Test.test
                "encodes every GPT-5.6 Luna reasoning effort"
                (\_ ->
                    Test.equal
                        [ "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"none\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"low\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"medium\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"high\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"xhigh\"}}"
                        , "{\"model\":\"gpt-5.6-luna\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"max\"}}"
                        ]
                        (List.map
                            (\effort ->
                                Responses.encodeRequest
                                    "gpt-5.6-luna"
                                    (Just effort)
                                    [ Provider.user "Solve it." ])
                            [ Responses.None
                            , Responses.Low
                            , Responses.Medium
                            , Responses.High
                            , Responses.XHigh
                            , Responses.Max
                            ]))
          , Test.test
                "encodes the model-dependent minimal effort"
                (\_ ->
                    Test.equal
                        "{\"model\":\"reasoning-model\",\"input\":[{\"role\":\"user\",\"content\":\"Solve it.\"}],\"reasoning\":{\"effort\":\"minimal\"}}"
                        (Responses.encodeRequest
                            "reasoning-model"
                            (Just Responses.Minimal)
                            [ Provider.user "Solve it." ]))
          ]
    ]
